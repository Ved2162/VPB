# ======================
# Database
# ======================
# PostgreSQL connection string (local or cloud e.g. Neon, Supabase, Railway)
DATABASE_URL=

# ======================
# Authentication
# ======================
# Strong random secret for signing JWT tokens (min 32 chars)
JWT_SECRET=

# ======================
# Razorpay Payment Gateway
# ======================
# Get from https://dashboard.razorpay.com → Settings → API Keys
# Use rzp_test_* for test mode, rzp_live_* for production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — configure at Razorpay Dashboard → Webhooks
# Point webhook URL to: https://yourdomain.com/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=

# ======================
# Seed Script (optional — used only when running /api/seed)
# ======================
# Override default admin credentials created by the seed endpoint
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
