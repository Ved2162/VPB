# ======================
# Database
# ======================
# PostgreSQL connection string (local or cloud e.g. Neon, Supabase, Railway)
DATABASE_URL=
# Optional local migration-owner connection. Keep out of Vercel runtime environments.
MIGRATION_DATABASE_URL=

# ======================
# Authentication
# ======================
# Strong random secret for signing JWT tokens (min 32 chars)
JWT_SECRET=

# ======================
# Razorpay Payment Gateway
# ======================
# Get from https://dashboard.razorpay.com → Settings → API Keys
# Use rzp_test_* for test mode, rzp_live_* for production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — configure at Razorpay Dashboard → Webhooks
# Point webhook URL to: https://yourdomain.com/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=

# ======================
# Seed Script (optional — used only when running /api/seed)
# ======================
# Seeding is disabled by default. Never enable demo data in production.
ALLOW_SEED=false
# Optional account creation requires explicit credentials; there are no default passwords.
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PHONE=
SEED_DEMO_PASSWORD=

# ======================
# Renflair SMS OTP
# ======================
# Get from https://sms.renflair.in — server-side only, never expose to frontend
RENFLAIR_API_KEY=

# MSG91 WhatsApp (server only). Disabled until the actual approved Utility
# template and integrated sender are configured. See docs/whatsapp.md.
MSG91_WHATSAPP_ENABLED=false
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=
MSG91_TEMPLATE_NAME=
MSG91_TEMPLATE_LANGUAGE=
# Set to literal null when MSG91's generated request specifies JSON null.
# Leave blank only while configuration is incomplete (sending stays blocked).
MSG91_TEMPLATE_NAMESPACE=
# Comma-separated fields in the EXACT approved body placeholder order.
# Allowed: customer_name,order_id,order_date,total_amount,confirmation_message,payment_status
MSG91_TEMPLATE_BODY_VARIABLES=
# Use number when the approved template already includes a currency symbol.
MSG91_TEMPLATE_AMOUNT_FORMAT=currency
# Separate random secret of at least 32 characters for the scheduled worker.
CRON_SECRET=
